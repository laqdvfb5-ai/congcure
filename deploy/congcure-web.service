[Unit]
Description=Congcure storefront
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=congcure
Group=congcure
WorkingDirectory=/opt/congcure/current/apps/web
EnvironmentFile=/etc/congcure/app.env
ExecStart=/usr/local/bin/node /opt/congcure/current/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
UMask=0027

[Install]
WantedBy=multi-user.target
